---
import PageLayout from '@/layouts/CommonPage.astro'
import { cvDownloadUrl } from '@/utils/cv'
import {
  Button,
  Icon,
  PublicationSection,
  ResearchProjectSection,
  SimpleIcon
} from '@/components/user'
import config from '@/site-config'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'research-interests', text: 'Research Interests' },
  { depth: 2, slug: 'publications', text: 'Publications' },
  { depth: 2, slug: 'open-source-projects', text: 'Open-source Projects' }
]
---

<PageLayout title='Academic' {headings} info={{ slug: '/academic', hideComment: true }}>
  <h2 id='about-me'>About Me<a class='anchor' href='#about-me'>#</a></h2>
  <p>
    I am a Master's student at the College of Intelligence Science, National University of Defense Technology (NUDT), and earned my B.Eng. in Artificial Intelligence from South China Normal University (SCNU).
  </p>
  
  <p>Here is my academic CV, feel free to download it.</p>
  <Button title='Download CV' class='w-fit' href={cvDownloadUrl} target='_blank'>
    <Icon class='size-5' name='download' slot='before' />
  </Button>
  <h2 id='research-interests'>
    Research Interests<a class='anchor' href='#research-interests'>#</a>
  </h2>
  <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
    {
      [
        {
          title: 'Robotics Manipulation',
          description: 'Robotic Manipulation, Grasping, Dexterous Control, Object Interaction',
          icon: 'ros'
        },
        {
          title: 'VLA',
          description: 'Vision-Language-Action Models, Multi-modal Learning, Embodied AI',
          icon: 'pytorch'
        },
        {
          title: 'Multi-Agent System',
          description: 'Cooperative MARL, Value Decomposition Methods',
          icon: 'kubernetes'
        }
      ].map((interest) => (
        <div class='group relative overflow-hidden rounded-xl border border-border bg-card p-4 transition-all hover:border-foreground/25 hover:shadow-md'>
          <div class='flex items-start gap-4'>
            <div class='flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/20'>
              <SimpleIcon
                class='size-5 text-primary transition-transform duration-300 group-hover:scale-110'
                name={interest.icon}
              />
            </div>
            <div class='flex-1'>
              <p class='text-xl font-medium leading-tight text-foreground transition-colors group-hover:text-primary'>
                {interest.title}
              </p>
              <p class='text-sm leading-relaxed text-muted-foreground'>{interest.description}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <h2 id='publications'>Publications<a class='anchor' href='#publications'>#</a></h2>
  <PublicationSection
    publications={[
      {
        title:
          'Puzzle: One Pass Is Not Enough for Open-Vocabulary Remote Sensing Segmentation',
        authors: [
          { name: 'Wensong Xu', isEqual: true },
          { name: 'Siqi Lu', isEqual: true },
          { name: 'Jibao Yuan', isMe: true, isEqual: true },
          { name: 'Yongbin Zheng', role: 'corresponding' }
        ],
        venue: 'arXiv preprint',
        year: '2026',
        type: 'preprint',
        // Full abstract and author marks from arXiv:2611.19146v1.
        abstract:
          'Open-vocabulary remote sensing image segmentation (OVRSIS) enables the segmentation of unseen classes without additional annotation or retraining. By analyzing the predictions of existing OVRSIS methods, we find that many misclassified patches coexist with visually similar, correctly classified patches of the same class within the same image. Unfortunately, most of these methods stop after a single inference rather than using their predictions to guide further inference. Motivated by this observation, we propose Puzzle, a plug-and-play iterative re-inference framework that combines prediction history with a visual-similarity prior to progressively refine patch-level attention. Puzzle employs a lightweight history-conditioned controller to regulate each patch’s contribution as an information source and its reliance on visually similar patches, while an adaptive stopping rule determines when to stop. It keeps the segmentation model frozen and reuses the same controller across different models and datasets without retraining. Extensive experiments demonstrate consistent performance improvements across diverse OVRSIS models and datasets, highlighting the strong transferability of Puzzle. Moreover, Puzzle can further improve the performance of SOTA methods.',
        links: [{ type: 'arxiv', href: 'https://arxiv.org/abs/2611.19146' }],
        status: 'preprint'
      },
      {
        title:
          'GraSLA: A Lightweight Spatial-Language-Action Model with Grasp Hypotheses as Geometric Priors',
        authors: [
          { name: 'Jibao Yuan', isMe: true, isEqual: true },
          { name: 'Zixiang Zhao', isEqual: true },
          { name: 'Wensong Xu', isEqual: true },
          { name: 'Siqi Lu', isEqual: true },
          { name: 'Shaofei Chen', role: 'corresponding' }
        ],
        venue: 'arXiv preprint',
        year: '2026',
        type: 'preprint',
        // Full abstract from arXiv:2611.15659v1.
        abstract:
          'This paper focuses on improving the behavioral diversity and effectiveness of language-conditioned manipulation policies trained through imitation learning. Recently, continuous-action policies have become mainstream in robotic manipulation, but the lack of diverse demonstrations tends to restrict their behavioral diversity. For grasping, a fundamental subtask of manipulation, 6-DoF grasp detection provides diverse grasp hypotheses, but open-loop execution constrains responsiveness in dynamic environments. This motivates us to combine the diversity of grasp hypotheses with the adaptability of continuous-action policies. To this end, we propose GraSLA, a lightweight and effective spatial-language-action model with grasp hypotheses as geometric priors. In particular, we employ spatial and language foundation models to encode scene geometry and task semantics, and integrate them with grasp hypotheses through bidirectional cross-attention for continuous action prediction. On LIBERO, GraSLA achieves an average success rate of 99.30%.',
        links: [
          { type: 'arxiv', href: 'https://arxiv.org/abs/2611.15659' },
          // Placeholder code link listed in the paper.
          { type: 'code', href: 'https://github.com/Minakanmi-Yuki/GraSLA' }
        ],
        status: 'preprint'
      },
      {
        title:
          'CommitFlow: Semantic Commitment Verification and Local Correction for Long-Horizon Robot Manipulation VLA Execution',
        // Jibao Yuan is third author per the author; arXiv metadata is pending an update.
        authors: [
          { name: 'Zixiang Zhao' },
          { name: 'Yansong Feng' },
          { name: 'Jibao Yuan', isMe: true },
          { name: 'Yang Yang' },
          { name: 'Chaoyu Wang' },
          { name: 'Haoran Xiao' },
          { name: 'Hui Zhang' },
          { name: 'Chuang Cheng', role: 'corresponding' },
          { name: 'Jianjun Ma' }
        ],
        venue: 'arXiv preprint',
        year: '2026',
        type: 'preprint',
        // Full abstract from arXiv:2609.21908v1.
        abstract:
          'Although vision-language-action (VLA) policies have advanced rapidly, long-horizon execution may still progress to the next task stage before the required physical effect has been established. We call this a mismatch between semantic commitments—physical conditions that a stage must establish or maintain—and the actual physical state. Because an action command alone cannot confirm such a condition, local deviations can propagate and cause task failure. To address this problem, we present CommitFlow, a closed-loop execution framework that combines commitment monitoring with local correction while keeping the base policy frozen. CommitFlow integrates three components. A Semantic Commitment Monitor (SCM) compares stage requirements against current state evidence and holds back dependent actions when a required condition is unmet or violated. BoundaryFlow then generates a local correction conditioned on the current state and base action, and Relation and Gain Calibration (RGC) selects the smallest correction strength that satisfies the relevant constraints. Across the ten common RoboTwin 2.0 benchmark tasks, CommitFlow achieves a mean success rate of 75.9%, improving on the base policy π₀.₅ by 22.7%. Cross-policy experiments show consistent gains, pointing toward reliable long-horizon robot execution.',
        links: [{ type: 'arxiv', href: 'https://arxiv.org/abs/2609.21908' }],
        status: 'preprint'
      },
      {
        title: 'GraRe: Grasp Candidate Re-Ranking for Frozen 6-DoF Grasp Detectors',
        authors: [
          { name: 'Jibao Yuan', isMe: true, isEqual: true },
          { name: 'Yuhui Zhao', isEqual: true },
          { name: 'Yinzhen Lv', isEqual: true },
          { name: 'Chao Xu', isEqual: true },
          { name: 'Shun Li', isEqual: true },
          { name: 'Chenxi Deng' },
          { name: 'Shaofei Chen', role: 'corresponding' }
        ],
        venue: 'arXiv preprint',
        year: '2026',
        type: 'preprint',
        // Full abstract from arXiv:2608.00946v3.
        abstract:
          'Existing 6-DoF grasp detectors typically rank grasp candidates by detector confidence. However, our analysis on GraspNet-1Billion shows that detector confidence is often poorly aligned with grasp quality, leaving successful grasp candidates at low ranks. Motivated by this observation, we study whether learned re-ranking can improve candidate ordering while keeping detector parameters and grasp candidates unchanged. We propose GraRe, which estimates grasp quality from candidate attributes, shell-stratified local geometry, and object context. Candidate attributes condition the local geometric and object-context representations, and a Transformer fuses all three feature types. The predicted quality is combined with detector confidence to produce the final ranking. Experiments on GraspNet-1Billion with five frozen detectors show consistent improvements, with gains of up to 13.56 points in Average AP. Real-robot experiments further demonstrate robust grasping in cluttered scenes. These results show that improving candidate ranking provides a practical way to enhance frozen 6-DoF grasp detectors. Project page is available at https://minakanmi-yuki.github.io/grare/.',
        links: [
          { type: 'arxiv', href: 'https://arxiv.org/abs/2608.00946' },
          { type: 'website', href: 'https://minakanmi-yuki.github.io/grare/' },
          { type: 'dataset', href: 'https://huggingface.co/datasets/jibaoyuan/grare-graspnet' },
          { type: 'model', href: 'https://huggingface.co/jibaoyuan/grare-graspnet' },
          { type: 'code', href: 'https://github.com/Minakanmi-Yuki/grare' }
        ],
        status: 'preprint'
      },
      {
        title: 'Construction and Study of an Explainable Logical Reasoning Dataset',
        authors: [
          { name: 'Yu Xiao' },
          { name: 'Jing Xiao' },
          { name: 'Guijin Lin' },
          { name: 'Rongsen Ni' },
          { name: 'Jiarong Xian' },
          { name: 'Jibao Yuan', isMe: true }
        ],
        venue: 'Journal of Computer Engineering & Applications',
        year: '2025',
        type: 'journal',
        abstract:
          'Logical reasoning is crucial for machine understanding, yet existing benchmarks lack detailed explanations of reasoning processes. This work introduces the Chinese-English Explainable Logical Reasoning (Ex-LoR) dataset, containing 3,411 problems with explanations across six reasoning categories. It defines question-answering and explanation-generation tasks, and experiments with several language models show that current systems still struggle to answer reliably and produce reasonable explanations.',
        links: [
          {
            type: 'doi',
            href: 'https://doi.org/10.3778/j.issn.1002-8331.2309-0458'
          }
        ],
        status: 'published'
      },
      {
        title: 'BERT-Enhanced Retrieval Tool for Homework Plagiarism Detection System',
        authors: [
          { name: 'Jiarong Xian', isEqual: true },
          { name: 'Jibao Yuan', isMe: true, isEqual: true },
          { name: 'Peiwei Zheng', isEqual: true },
          { name: 'Dexian Chen', isEqual: true },
          { name: 'Yuntao Nie' }
        ],
        venue: 'arXiv preprint',
        year: '2024',
        type: 'preprint',
        // Full abstract from arXiv:2404.01582v2.
        abstract:
          'Text plagiarism detection task is a common natural language processing task that aims to detect whether a given text contains plagiarism or copying from other texts. In existing research, detection of high level plagiarism is still a challenge due to the lack of high quality datasets. In this paper, we propose a plagiarized text data generation method based on GPT-3.5, which produces 32,927 pairs of text plagiarism detection datasets covering a wide range of plagiarism methods, bridging the gap in this part of research. Meanwhile, we propose a plagiarism identification method based on Faiss with BERT with high efficiency and high accuracy. Our experiments show that the performance of this model outperforms other models in several metrics, including 98.86%, 98.90%, 98.86%, and 0.9888 for Accuracy, Precision, Recall, and F1 Score, respectively. At the end, we also provide a user-friendly demo platform that allows users to upload a text library and intuitively participate in the plagiarism analysis.',
        links: [{ type: 'arxiv', href: 'https://arxiv.org/abs/2404.01582' }],
        status: 'preprint'
      }
    ]}
  />
