---
import { Icon } from '@/components/user'

const { header: headerName, content: contentName, needPercent = true } = Astro.props
---

<button
  aria-label='Back to Top'
  class='z-90 group fixed bottom-8 end-4 flex h-10 w-10 translate-y-28 items-center justify-center rounded-full border-2 border-transparent bg-muted text-muted-foreground opacity-0 transition-all duration-300 hover:border-border/75 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12'
  data-show='false'
  data-header={headerName}
  data-content={contentName}
  data-percent={needPercent}
  id='to-top-btn'
>
  <div
    class='absolute bottom-0 end-0 start-0 top-0 flex items-center justify-center transition-opacity group-hover:opacity-0 group-[.ended]:opacity-0'
  >
    <span class='text'>0</span>
    <span class='text-xs'>%</span>
  </div>
  <Icon
    name='up'
    class='opacity-0 transition-opacity group-hover:opacity-100 group-[.ended]:opacity-100'
  />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('#to-top-btn')
  const text = button?.querySelector<HTMLElement>('.text')
  const header = document.getElementById(button?.dataset.header || '')
  const article = document.getElementById(button?.dataset.content || '')

  if (button) {
    button.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      window.scrollTo({ behavior: reduce ? 'instant' : 'smooth', top: 0 })
    })

    if (header) {
      const observer = new IntersectionObserver(([entry]) => {
        button.dataset.show = String(!entry.isIntersecting)
      })
      observer.observe(header)
    }

    if (button.dataset.percent === 'true' && article && text) {
      let height = 0
      let top = 0
      let viewport = 0
      let previous = -1
      let frame = 0

      function update() {
        frame = 0
        const percent = Math.max(
          0,
          Math.min(100, Math.round(((window.scrollY - top) / Math.max(height - viewport, 1)) * 100))
        )
        if (percent === previous) return
        previous = percent
        text!.textContent = String(percent)
        button!.classList.toggle('ended', percent >= 100)
      }

      function schedule() {
        if (!frame) frame = requestAnimationFrame(update)
      }

      function measure() {
        height = article!.scrollHeight
        top = article!.getBoundingClientRect().top + window.scrollY
        viewport = document.documentElement.clientHeight
        schedule()
      }

      // Images and responsive content can change height long after initial page load.
      if ('ResizeObserver' in window) new ResizeObserver(measure).observe(article)
      article.addEventListener('animationend', measure)
      window.addEventListener('resize', measure, { passive: true })
      document.addEventListener('scroll', schedule, { passive: true })
      measure()
    } else {
      button.classList.add('ended')
    }
  }
</script>
