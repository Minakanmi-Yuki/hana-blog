---
interface Props {
  username: string
}

const { username } = Astro.props
const profileUrl = `https://github.com/${encodeURIComponent(username)}`
---

<github-activity-calendar class='block w-full' data-username={username}>
  <div class='w-full overflow-x-auto' style='max-width: 90vw;'>
    <div
      data-activity-chart
      class='flex min-h-[130px] items-center text-muted-foreground'
      role='status'
    >
      GitHub activity
    </div>
  </div>
  <footer class='flex items-center justify-between gap-3'>
    <a href={profileUrl} target='_blank' rel='noopener noreferrer' data-activity-total>
      View on GitHub
    </a>
    <div class='flex items-center gap-1'>
      <span>Less</span>
      {
        [0, 1, 2, 3, 4].map((level) => (
          <svg width='12' height='12' aria-hidden='true'>
            <rect width='12' height='12' rx='2' ry='2' data-level={level} />
          </svg>
        ))
      }
      <span>More</span>
    </div>
  </footer>
</github-activity-calendar>

<script>
  import '../../scripts/github-activity'
</script>

<style>
  github-activity-calendar {
    --activity-0: #ebedf0;
    --activity-1: #c6e48b;
    --activity-2: #7bc96f;
    --activity-3: #239a3b;
    --activity-4: #196127;
  }

  :global(.dark) github-activity-calendar {
    --activity-0: #161b22;
    --activity-1: #0e4429;
    --activity-2: #006d32;
    --activity-3: #26a641;
    --activity-4: #39d353;
  }

  github-activity-calendar :global(rect[data-level='0']) {
    fill: var(--activity-0);
  }
  github-activity-calendar :global(rect[data-level='1']) {
    fill: var(--activity-1);
  }
  github-activity-calendar :global(rect[data-level='2']) {
    fill: var(--activity-2);
  }
  github-activity-calendar :global(rect[data-level='3']) {
    fill: var(--activity-3);
  }
  github-activity-calendar :global(rect[data-level='4']) {
    fill: var(--activity-4);
  }
  github-activity-calendar :global(rect[data-date]:hover) {
    opacity: 0.8;
  }
</style>
