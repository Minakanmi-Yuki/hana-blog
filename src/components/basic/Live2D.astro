---
import engineUrl from '../../../vendor/live2d/0.9.2/live2d-lite.js?url'
import widgetUrl from '../../../vendor/live2d/0.9.2/waifu-tips.js?url'
import messagesUrl from '../../../vendor/live2d/0.9.2/waifu-tips.json?url'
import styleUrl from '../../../vendor/live2d/0.9.2/waifu.css?url'

const baseUrl = import.meta.env.BASE_URL
---

<div
  id='live2d-config'
  hidden
  data-source={`${baseUrl}live2d-autoload.js?v=20261117-lite-v1`}
  data-engine={engineUrl}
  data-widget={widgetUrl}
  data-messages={messagesUrl}
  data-style={styleUrl}
  data-model-path={`${baseUrl}live2d-api/`}
>
</div>

<script>
  const config = document.querySelector<HTMLElement>('#live2d-config')
  const desktop = window.matchMedia('(min-width: 768px)')
  let started = false
  let scheduled = false

  function load() {
    scheduled = false
    if (!config || started || document.hidden || !desktop.matches) return
    started = true
    const script = document.createElement('script')
    script.src = config.dataset.source || ''
    Object.assign(script.dataset, config.dataset)
    script.async = true
    script.addEventListener(
      'error',
      () => {
        started = false
        script.remove()
      },
      { once: true }
    )
    document.body.appendChild(script)
  }

  function schedule() {
    if (!config || started || scheduled || document.hidden || !desktop.matches) return
    scheduled = true
    if ('requestIdleCallback' in window) window.requestIdleCallback(load, { timeout: 2000 })
    else setTimeout(load, 300)
  }

  document.addEventListener('visibilitychange', schedule)
  desktop.addEventListener('change', schedule)
  window.addEventListener('online', schedule)
  window.addEventListener('pageshow', schedule)
  window.addEventListener('live2d:error', () => {
    started = false
  })
  schedule()
</script>

<style>
  :global(#waifu-tips) {
    animation: none !important;
  }

  @media (max-width: 767px) {
    :global(#waifu),
    :global(#waifu-toggle) {
      display: none !important;
    }
  }
</style>
